# Copy to profiles.yml (gitignored) or ~/.dbt/profiles.yml.
# On ClickHouse, omit `database` or set it equal to `schema`.
data_quality_metrics:
  target: dev_postgres
  outputs:
    dev_postgres:
      type: postgres
      host: "{{ env_var('DBT_POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_POSTGRES_PORT', '5432') | as_number }}"
      user: "{{ env_var('DBT_POSTGRES_USER', 'secret') }}"
      password: "{{ env_var('DBT_POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('DBT_POSTGRES_DB', 'postgres') }}"
      schema: "{{ env_var('DBT_POSTGRES_SCHEMA', 'lineage') }}"
      threads: 2

    dev_clickhouse:
      type: clickhouse
      host: "{{ env_var('DBT_CLICKHOUSE_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_CLICKHOUSE_PORT', '8123') | as_number }}"
      user: "{{ env_var('DBT_CLICKHOUSE_USER', 'secret') }}"
      password: "{{ env_var('DBT_CLICKHOUSE_PASSWORD') }}"
      schema: "{{ env_var('DBT_CLICKHOUSE_SCHEMA', 'dq') }}"
      threads: 2
